def cmd_doctor(o):
    import shutil
    problems = []
    win = os.name == "nt"
    build = "powershell -ExecutionPolicy Bypass -File build.ps1" if win else "./build.sh"

    def line(ok, what, detail, fix=None):
        say("  %-5s %-24s %s" % ("ok" if ok else ("FIX" if fix else "info"), what, detail),
            None if ok else ("red" if fix else "darkgray"))
        if not ok and fix:
            say("        -> " + fix, "yellow")
            problems.append(what)

    say("Checking your setup...", "cyan")
    smi = shutil.which("nvidia-smi")
    gpu = ""
    if smi:
        r = subprocess.run([smi, "--query-gpu=name", "--format=csv,noheader"], capture_output=True, text=True)
        gpu = r.stdout.strip().splitlines()[0] if r.returncode == 0 and r.stdout.strip() else ""
    line(bool(gpu), "NVIDIA GPU", gpu or "not found - fine: the search runs on OpenCL or the CPU instead")
    nvcc = shutil.which("nvcc") or next((p for p in ["/opt/cuda/bin/nvcc", "/usr/local/cuda/bin/nvcc"] if os.path.exists(p)), None)
    ver = ""
    if nvcc:
        m = re.search(r"release ([\d.]+)", subprocess.run([nvcc, "--version"], capture_output=True, text=True).stdout)
        ver = m.group(1) if m else "?"
    line(bool(nvcc), "CUDA toolkit (nvcc)", ver or "not found - only the NVIDIA-only tools need it (Arch: sudo pacman -S cuda)")
    cxx = shutil.which("g++") or shutil.which("cl")
    line(bool(cxx), "C++ compiler", os.path.basename(cxx) if cxx else "not found",
         "install gcc (Arch: sudo pacman -S gcc)" if not win else "install VS Build Tools (C++ workload)")
    ps = ps_command()
    line(bool(ps), "PowerShell", ps[0] if ps else "not found",
         "PowerShell 7: unpack Microsoft's linux-x64 tarball into ~/.local/share and link pwsh into ~/.local/bin (LINUX.md)")
    java = shutil.which("java")
    line(bool(java), "Java (parity tests)", java or "not found - only ./vanilla_parity.py needs it")

    say("\nThe tools:", "cyan")
    built_ok = True
    for name, srcs in TOOL_SOURCES.items():
        exe = os.path.join(ROOT, name + (".exe" if win else ""))
        if not os.path.exists(exe):
            if name in ("hotspot_scan", "slime_gpu", "phase_prepass") and not nvcc:
                line(False, os.path.basename(name), "not built - needs an NVIDIA GPU with CUDA (the search runs without it)")
                continue
            line(False, os.path.basename(name), "not built", build)
            built_ok = False
            continue
        common = ["slime_core.h", "portable_paths.h"]
        newest = max((os.path.getmtime(os.path.join(ROOT, s)) for s in srcs + common if os.path.exists(os.path.join(ROOT, s))), default=0)
        stale = os.path.getmtime(exe) < newest
        line(not stale, os.path.basename(name), "older than its source - rebuild" if stale else "built", build if stale else None)
        built_ok &= not stale
    for name in SEARCH_TOOLS:
        if os.path.exists(tool(name)):
            rc, out = run_capture([tool(name), "--seed", "1", "--m-chunks", "1", "--center-x", "0", "--center-z", "0"], timeout=60)
            if any(l.startswith("Best:") for l in out):
                line(True, "%s runs" % name, "yes, on " + SEARCH_ON[name])
            elif "no kernel image" in " ".join(out):
                line(False, "%s runs" % name, "built for a different GPU", build)
            else:
                line(False, "%s runs" % name, (out[-1] if out else "no output")[:70],
                     build if name == "slime_cpu" else None)
    best = searcher()
    line(bool(best), "position search", ("using " + SEARCH_ON[best]) if best else "no search tool works here",
         build + "   (then ./slime doctor again)")
    if os.path.exists(tool("slime_refine")):
        rc, out = run_capture([tool("slime_refine"), "--self-test"], timeout=120)
        line(any("SELF TEST PASSED" in l for l in out), "scoring self-test", "passed" if rc == 0 else "FAILED", build)
    if o.full:
        for t in ("hotspot_scan", "slime_gpu"):
            if os.path.exists(tool(t)):
                say("  running %s --self-test..." % t, "darkgray")
                rc, out = run_capture([tool(t), "--self-test"], timeout=600)
                line(any("SELF TEST PASSED" in l for l in out), "%s self-test" % t, "passed" if rc == 0 else "FAILED", build)

    say("\nYour data:", "cyan")
    farms = filed_farms()
    line(True, "farms filed", "%d in main/records/" % len(farms))
    line(True, "in-game readings", "%d in main/records/measured_in_game.csv" % len(measured_rows()))
    bs = os.path.exists(os.path.join(DATA, "best_spots.csv"))
    line(bs, "spot list", "main/best_spots.csv " + ("present" if bs else "missing - only ./slime search needs it"))

    say()
    if problems:
        say("%d thing(s) to fix - do the -> lines above, then run ./slime doctor again." % len(problems), "red")
        return 1
    say("All good. Run ./slime for the menu." if built_ok else "All good.", "green")
    return 0


# ---- the menu -------------------------------------------------------------------------------
def ask(label, default=None, conv=str, hint=""):
    while True:
        shown = (" [%s]" % default) if default not in (None, "") else ""
        try:
            s = input("  %s%s%s: " % (label, (" (" + hint + ")") if hint else "", shown)).strip()
        except EOFError:
            say()
            raise SystemExit(0)
        if not s and default not in (None, ""):
            s = str(default)
        if not s:
            say("    an answer is needed here", "yellow")
            continue
        try:
            return conv(s)
        except (ValueError, argparse.ArgumentTypeError) as e:
            say("    that doesn't work: %s" % (e or "try again"), "yellow")


def ask_xz(label, default=None):
    def conv(s):
        p = re.split(r"[\s,]+", s.strip())
        if len(p) != 2:
            raise ValueError("type two numbers, x then z (like 3680 6989)")
        return int(p[0]), int(p[1])
    d = "%d %d" % default if default else None
    return ask(label, d, conv, "x z")


def menu():
    while True:
        p = load_prefs()
        farm = p.get("farm") or {}
        say()
        say("slime - slime farm finder", "cyan")
        if p.get("seed") is not None:
            say("  remembered: seed %s%s" % (p["seed"], ("   farm %s,%s" % (farm["x"], farm["z"])) if farm else ""), "darkgray")
        say("""
  1  Find the best farm in my world          6  My best farms
  2  Check one farm (score + best height)    7  I measured a farm in game
  3  Build a farm in game (commands)         8  Stop everything
  4  Hunt for a record                       9  Check my setup
  5  Hunt progress so far                    0  Quit

  g  Open the app (SlimeByte): map, best spot, perimeter commands, build guide
""")
        c = ask("pick a number", None, str).strip()
        if c in ("0", "q", "quit", "exit"):
            return 0
        argv = menu_args(c, p, farm)
        if argv is None:
            say("    pick one of the numbers above", "yellow")
            continue
        say("\nnext time you can type:  ./slime " + " ".join(shlex.quote(a) for a in argv), "darkgray")
        say()
        try:
            main(argv)
        except SystemExit:
            pass
        except KeyboardInterrupt:
            say("\nstopped.", "yellow")
        try:
            if input("\nEnter for the menu, q to quit: ").strip().lower().startswith("q"):
                return 0
        except EOFError:
            return 0


def menu_args(c, p, farm):
    seed_default = p.get("seed")
    if c == "1":
        seed = ask("your world seed", seed_default, seed_value, "number or text, /seed shows it")
        x, z = ask_xz("search around", (0, 0))
        return ["best-spot", "--seed", str(seed), "--x", str(x), "--z", str(z)]
    if c in ("2", "3"):
        seed = ask("world seed", farm.get("seed", seed_default), seed_value)
        fx = (farm.get("best_x", farm.get("x")), farm.get("best_z", farm.get("z"))) if farm and farm.get("seed") == seed else None
        x, z = ask_xz("farm AFK spot", fx if fx and None not in fx else None)
        if c == "2":
            return ["check", "--seed", str(seed), "--x", str(x), "--z", str(z)]
        ver = ask("your Minecraft version", p.get("version", "1.21.11"), str, "like 1.21.11")
        return ["perimeter", "--seed", str(seed), "--x", str(x), "--z", str(z), "--version", ver]
    if c == "4":
        kind = ask("1 normal hunt, or 2 exact phase search (needs main/best_spots.csv)", "1")
        n = ask("how many cycles", 12, int)
        return ["search", "--cycles", str(n)] if kind.strip() == "2" else ["hunt", "--cycles", str(n)]
    if c == "5":
        return ["status"]
    if c == "6":
        return ["farms"]
    if c == "7":
        seed = ask("world seed", farm.get("seed", seed_default), seed_value)
        x, z = ask_xz("where you stood", None)
        fy = ask("your feet y", -39, int)
        n = ask("what /perimeterinfo said (spawning spaces)", None, int)
        return ["measured", "--seed", str(seed), "--x", str(x), "--z", str(z), "--feet-y", str(fy), "--ingame", str(n)]
    if c == "8":
        return ["stop"]
    if c == "9":
        return ["doctor"]
    if c.lower() == "g":
        return ["gui"]
    return None


