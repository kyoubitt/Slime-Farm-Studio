def build_parser():
    p = argparse.ArgumentParser(prog="slime", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--device", type=int, default=None, help="CUDA device index (default 0)")
    sub = p.add_subparsers(dest="cmd")

    def farm_args(s, required=True, xz_help="farm AFK spot, blocks"):
        s.add_argument("--seed", type=seed_arg, required=True, help="world seed (number or text)")
        s.add_argument("--x", type=int, required=required, help=xz_help)
        s.add_argument("--z", type=int, required=required)

    s = sub.add_parser("best-spot", help="best farm spot in your world")
    s.add_argument("--seed", type=seed_arg, required=True, help="world seed (number or text)")
    s.add_argument("--x", type=int, default=0, help="search centre, blocks (default spawn 0,0)")
