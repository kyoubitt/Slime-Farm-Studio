COMMANDS = {"best-spot": cmd_best_spot, "check": cmd_check, "score": cmd_score, "y": cmd_y,
            "perimeter": cmd_perimeter, "hunt": cmd_hunt, "search": cmd_search, "status": cmd_status,
            "stop": cmd_stop, "farms": cmd_farms, "measured": cmd_measured, "doctor": cmd_doctor, "gui": cmd_gui,
            "climb": cmd_climb, "dupes": cmd_dupes}


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    p = build_parser()
    o, extra = p.parse_known_args(argv)
    if extra and o.cmd != "verify":
        p.error("unrecognized arguments: " + " ".join(extra))
    if o.device is not None:
        os.environ["SLIME_DEVICE"] = str(o.device)
    os.chdir(ROOT)
    if not o.cmd:
        return menu()
    if o.cmd == "verify":
        return cmd_verify(o, extra)
    return COMMANDS[o.cmd](o)


if __name__ == "__main__":
    try:
