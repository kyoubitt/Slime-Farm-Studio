import shlex
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from slime_common import (DATA, PERIMETER_BANDS, ROOT, SEARCH_ON, SEARCH_TOOLS, die, load_prefs, num,  # noqa: E402
