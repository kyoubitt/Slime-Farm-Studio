def run_ps(script, *args):
    cmd = ps_command()
    if not cmd:
        die("PowerShell 7 (pwsh) not found - see LINUX.md 'What you need', or ./slime doctor")
    sys.stdout.flush()
    try:
        return subprocess.call(cmd + [os.path.join(ROOT, script)] + [str(a) for a in args], cwd=ROOT)
    except KeyboardInterrupt:
        say("\ninterrupted - run ./slime stop to make sure nothing is left on the GPU", "yellow")
        return 130


